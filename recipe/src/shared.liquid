<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@800;900&family=IBM+Plex+Mono:wght@400;500;600&display=block" rel="stylesheet">
<style>
  .view:has(> .sp) { position: relative; padding: 0; overflow: hidden; }
  .sp { position: absolute; inset: 0; overflow: hidden; container-type: size;
        --bg: #f2eee6; --ink: #111111; --muted: #444455; --sky: #ee9977; --ray: #ffbf80; --top: #442233;
        --accent: #dd2233; --on-accent: #ffffff; --pad-fill: #ffffff;
        --sky-h: 64%; --pad: 4.4cqw; --f-top: max(11px, 1.35cqw); --f-meta: max(12px, 1.45cqw);
        --f-title: 6.2cqw; --f-sub: max(12px, 1.5cqw); --stamp: min(10.5cqw, 17cqh); --shadow: max(6px, .8cqw);
        background: var(--bg); color: var(--ink); font-family: 'IBM Plex Mono', ui-monospace, monospace; }
  /* une couleur de ciel par rubrique : crépuscule des nouvelles saisons, projecteurs dorés des nouvelles séries */
  .sp--sec-seasons { --sky: #ee9977; --ray: #ffbf80; --top: #442233; }
  .sp--sec-series { --sky: #ffcc44; --ray: #ffcc88; --top: #442233; }
  .sp.sp--eink { --bg: #ffffff; --ink: #000000; --muted: #000000; --sky: #ffffff; --ray: url(#sp-dots); --top: #000000;
                 --accent: #000000; --on-accent: #ffffff; }

  .sp-sky { position: absolute; left: 0; right: 0; top: 0; height: var(--sky-h); background: var(--sky); overflow: hidden; }
  .sp-rays { position: absolute; inset: 0; width: 100%; height: 100%; }
  .sp-art { position: absolute; left: 8%; right: 8%; top: 17%; bottom: 10%; display: flex; align-items: center; justify-content: center; }
  .sp-frame { position: relative; flex: 0 0 auto; border: max(3px, .3cqw) solid var(--ink); background: var(--ink);
              box-shadow: var(--shadow) var(--shadow) 0 var(--ink); visibility: hidden; }
  .sp-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .sp--eink .sp-frame img { filter: grayscale(1) brightness(1.15) contrast(1.15); }
  .sp--img .sp-frame { visibility: visible; }
  .sp-tv { display: none; width: 72%; height: 92%; }
  .sp--noimg .sp-frame { display: none; }
  .sp--noimg .sp-tv { display: block; }
  .sp-tag { position: absolute; left: calc(-1 * var(--shadow)); top: calc(-1.4 * var(--shadow)); padding: .25em .6em;
            background: var(--ink); color: var(--bg); font-size: var(--f-top); letter-spacing: .2em; text-transform: uppercase;
            white-space: nowrap; }
  .sp-tag:empty { display: none; }
  .sp-top { position: absolute; top: calc(var(--pad) * .6); left: var(--pad); right: var(--pad); display: flex;
            justify-content: space-between; gap: 2em; font-size: var(--f-top); letter-spacing: .28em;
            text-transform: uppercase; color: var(--top); white-space: nowrap; }
  .sp-top > span:first-child { overflow: hidden; text-overflow: ellipsis; }
  /* les libellés restent lisibles par-dessus les rayons */
  .sp-top > span { background: var(--sky); padding: .25em .5em; margin: -.25em -.5em; }
  .sp-upd-short { display: none; }
  .sp--half_horizontal .sp-upd-long, .sp--half_vertical .sp-upd-long, .sp--quadrant .sp-upd-long { display: none; }
  .sp--half_horizontal .sp-upd-short, .sp--half_vertical .sp-upd-short, .sp--quadrant .sp-upd-short { display: inline; }

  .sp-info { position: absolute; left: var(--pad); right: var(--pad); top: var(--sky-h); bottom: 0;
             border-top: max(2px, .25cqw) solid var(--ink); display: flex; align-items: center; gap: 3cqw; }
  .sp-text { flex: 1 1 auto; min-width: 0; }
  .sp-meta { font-size: var(--f-meta); letter-spacing: .2em; text-transform: uppercase; color: var(--muted);
             white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp-title { font-family: 'Archivo', 'Arial Black', sans-serif; font-weight: 900; font-size: var(--f-title);
              line-height: 1.05; text-transform: uppercase; margin: .18em 0 .14em; white-space: nowrap; overflow: hidden; }
  .sp-title.wrap { white-space: normal; line-height: 1.02; overflow-wrap: anywhere; }
  .sp-sub { font-size: var(--f-sub); color: var(--muted); letter-spacing: .03em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sp-sub b { color: var(--ink); font-weight: 500; }
  .sp-next { margin-top: .45em; }
  .sp-stamp { flex: 0 0 auto; text-align: center; font-size: var(--f-top); letter-spacing: .2em; color: var(--muted);
              text-transform: uppercase; white-space: nowrap; }
  .sp-ring { display: flex; align-items: center; justify-content: center; width: var(--stamp); height: var(--stamp);
             margin: .45em auto; border-radius: 50%; background: var(--accent); color: var(--on-accent);
             transform: rotate(-8deg); font-family: 'Archivo', 'Arial Black', sans-serif; font-weight: 900;
             font-size: calc(var(--stamp) * .44); letter-spacing: -.02em; line-height: 1; }
  .sp-ring.long { font-size: calc(var(--stamp) * .3); }
  .sp-ring.word { font-size: calc(var(--stamp) * .2); letter-spacing: .02em; text-transform: uppercase; }
  .sp-ring.none { background: transparent; color: var(--ink); border: max(3px, .3cqw) solid var(--ink); }
  .sp-err .sp-meta { color: var(--accent); }
  .sp--error .sp-stamp, .sp--error .sp-next, .sp--error .sp-tag { display: none; }
  /* e-ink 1 bit : pas d'anticrénelage, il faut des traits plus épais */
  .sp--eink { font-weight: 600; --f-top: max(13px, 1.35cqw); --f-meta: max(13px, 1.45cqw); --f-sub: max(13px, 1.5cqw); }
  .sp--eink .sp-sub b { font-weight: 600; }
  .sp--eink .sp-top, .sp--eink .sp-meta { letter-spacing: .14em; }

  .sp--half_horizontal { --pad: 3cqw; --f-title: 4.6cqw; --stamp: 30cqh; }
  .sp--half_horizontal .sp-sky { right: auto; width: 34%; height: 100%; border-right: max(2px, .25cqw) solid var(--ink); }
  .sp--half_horizontal .sp-art { left: 9%; right: 11%; top: 16%; bottom: 9%; }
  .sp--half_horizontal .sp-info { left: calc(34% + var(--pad)); top: 0; border-top: 0; }
  .sp--half_horizontal .sp-top > span:first-child, .sp--half_vertical .sp-top > span:first-child,
  .sp--quadrant .sp-top > span:first-child { display: none; }
  .sp--half_horizontal .sp-top, .sp--half_vertical .sp-top, .sp--quadrant .sp-top { justify-content: flex-end; letter-spacing: .1em; }
  .sp--half_horizontal .sp-next, .sp--quadrant .sp-next { display: none; }
  .sp--half_vertical { --sky-h: 50%; --pad: 5cqw; --f-top: max(11px, 2.6cqw); --f-meta: max(11px, 2.9cqw);
                       --f-title: 9cqw; --f-sub: max(12px, 3.2cqw); --stamp: 19cqw; }
  .sp--half_vertical .sp-art { left: 6%; right: 8%; top: 12%; bottom: 9%; }
  .sp--half_vertical .sp-meta, .sp--half_vertical .sp-sub { white-space: normal; line-height: 1.5; }
  .sp--half_vertical .sp-info { align-items: flex-start; padding-top: 7cqw; }
  .sp--quadrant { --sky-h: 46%; --pad: 4.5cqw; --f-top: max(11px, 2.8cqw); --f-meta: max(11px, 2.8cqw);
                  --f-title: 7.5cqw; --f-sub: max(11px, 2.8cqw); --stamp: 15cqw; }
  .sp--quadrant .sp-art { left: 4%; right: 6%; top: 17%; bottom: 9%; }
  /* petits formats : le tampon chevauche le bas de l'affiche */
  .sp--half_vertical .sp-stamp, .sp--quadrant .sp-stamp { position: absolute; right: 0; top: calc(var(--stamp) * -.62); }
  .sp--half_vertical .sp-stamp > span, .sp--quadrant .sp-stamp > span { display: none; }
  .sp--half_vertical .sp-text, .sp--quadrant .sp-text { padding-right: calc(var(--stamp) * .55); }
  .sp--half_vertical .sp-meta, .sp--quadrant .sp-meta { margin-right: calc(var(--stamp) * .5); }
</style>

{% template showposter %}
<div class="sp sp--{{ size }}{% if cf.style == 'color' %} sp--color{% else %} sp--eink{% endif %}"
     data-lang="{{ cf.language | default: 'en' }}" data-featured="{{ cf.featured | default: 'rotate' }}"
     data-key="{% if cf.trakt_id != blank %}1{% endif %}" data-tmdb="{{ cf.tmdb_key | strip }}"
     data-error="{% if prem.error %}1{% endif %}"
     data-ts="{{ ts }}" data-off="{{ off | default: 0 }}">
  <script type="application/json" class="sp-prem">{{ prem.data | json }}</script>
  <script type="application/json" class="sp-ant">{{ ant.data | json }}</script>
  <div class="sp-sky">
    <svg class="sp-rays" viewBox="0 0 1280 540" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <pattern id="sp-dots" width="16" height="16" patternUnits="userSpaceOnUse">
          <rect width="16" height="16" fill="#fff"/>
          <circle cx="4" cy="4" r="1.6" fill="#000"/><circle cx="12" cy="12" r="1.6" fill="#000"/>
        </pattern>
      </defs>
      <g class="sp-rays-g" style="fill:var(--ray)"></g>
    </svg>
    <!-- l'affiche de la série, cernée de noir comme les jaquettes de GamePoster ; un téléviseur si elle manque -->
    <div class="sp-art">
      <div class="sp-frame"><img class="sp-cover" alt=""><span class="sp-tag"></span></div>
      <svg class="sp-tv" viewBox="0 0 440 360" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
        <path d="M160 20 L216 84 L292 12" style="fill:none;stroke:var(--ink)" stroke-width="10" stroke-linecap="round" stroke-linejoin="round"/>
        <rect x="30" y="84" width="380" height="236" rx="34" style="fill:var(--pad-fill);stroke:var(--ink)" stroke-width="10"/>
        <rect x="62" y="114" width="250" height="176" rx="26" style="fill:var(--ink)"/>
        <path d="M92 148 Q100 136 116 134" style="fill:none;stroke:var(--pad-fill)" stroke-width="8" stroke-linecap="round"/>
        <circle cx="362" cy="148" r="20" style="fill:var(--accent);stroke:var(--ink)" stroke-width="6"/>
        <circle cx="362" cy="206" r="14" style="fill:var(--pad-fill);stroke:var(--ink)" stroke-width="6"/>
        <path d="M340 248 H384 M340 270 H384" style="stroke:var(--ink)" stroke-width="7" stroke-linecap="round"/>
        <path d="M90 320 L76 346 M350 320 L364 346" style="stroke:var(--ink)" stroke-width="10" stroke-linecap="round"/>
      </svg>
    </div>
    <div class="sp-top">
      <span class="sp-k"></span>
      <span class="sp-upd"><span class="sp-upd-long"></span><span class="sp-upd-short"></span><span class="sp-time">--:--</span></span>
    </div>
  </div>
  <div class="sp-info">
    <div class="sp-text">
      <div class="sp-meta"></div>
      <div class="sp-title"></div>
      <div class="sp-sub sp-genres"></div>
      <div class="sp-sub sp-next"></div>
    </div>
    <div class="sp-stamp">
      <span class="sp-stamp-k"></span>
      <div class="sp-ring"></div>
      <span class="sp-stamp-l"></span>
    </div>
  </div>
</div>
{% endtemplate %}

<script>
(function () {
  var IMG = 'https://image.tmdb.org/t/p/w780';
  // Téléréalité, jeux, talk-shows, infos et feuilletons ne sont pas des « sorties »
  var SKIP = ['reality', 'game-show', 'talk-show', 'news', 'soap', 'home-and-garden', 'special-interest'];
  var GENRES = {
    fr: { action: 'Action', adventure: 'Aventure', animation: 'Animation', anime: 'Anime', comedy: 'Comédie', crime: 'Policier',
          documentary: 'Documentaire', drama: 'Drame', family: 'Familial', fantasy: 'Fantastique', history: 'Histoire',
          horror: 'Horreur', music: 'Musique', musical: 'Comédie musicale', mystery: 'Mystère', romance: 'Romance',
          'science-fiction': 'Science-fiction', superhero: 'Super-héros', suspense: 'Suspense', thriller: 'Thriller',
          war: 'Guerre', western: 'Western', children: 'Jeunesse', biography: 'Biographie', sports: 'Sport' },
    en: { action: 'Action', adventure: 'Adventure', animation: 'Animation', anime: 'Anime', comedy: 'Comedy', crime: 'Crime',
          documentary: 'Documentary', drama: 'Drama', family: 'Family', fantasy: 'Fantasy', history: 'History',
          horror: 'Horror', music: 'Music', musical: 'Musical', mystery: 'Mystery', romance: 'Romance',
          'science-fiction': 'Science Fiction', superhero: 'Superhero', suspense: 'Suspense', thriller: 'Thriller',
          war: 'War', western: 'Western', children: 'Kids', biography: 'Biography', sports: 'Sports' }
  };
  var I18N = {
    fr: {
      seasons: 'Nouvelles saisons', series: 'Nouvelles séries',
      countries: { US: 'américaine', GB: 'britannique', FR: 'française', CA: 'canadienne', BE: 'belge', ES: 'espagnole',
                   DE: 'allemande', IT: 'italienne', DK: 'danoise', SE: 'suédoise', NO: 'norvégienne', FI: 'finlandaise',
                   IS: 'islandaise', AU: 'australienne', KR: 'coréenne', JP: 'japonaise', CN: 'chinoise', IN: 'indienne',
                   MX: 'mexicaine', BR: 'brésilienne', AR: 'argentine', CO: 'colombienne', NZ: 'néo-zélandaise', IE: 'irlandaise',
                   NL: 'néerlandaise', PL: 'polonaise', TR: 'turque', TW: 'taïwanaise', TH: 'thaïlandaise', CH: 'suisse' },
      nation: function (c) { return 'Série ' + c; },
      updated: 'Dernière actualisation à ', upd: 'Màj ',
      days: ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'],
      months: ['janvier', 'février', 'mars', 'avril', 'mai', 'juin', 'juillet', 'août', 'septembre', 'octobre', 'novembre', 'décembre'],
      mshort: ['janv.', 'févr.', 'mars', 'avr.', 'mai', 'juin', 'juil.', 'août', 'sept.', 'oct.', 'nov.', 'déc.'],
      date: function (d, m, n) { return d + ' ' + (n === 1 ? '1er' : n) + ' ' + m; },
      dshort: function (m, n) { return (n === 1 ? '1er' : n) + ' ' + m; },
      out: function (n) { return n === 0 ? 'Aujourd\'hui' : n === 1 ? 'Demain' : 'Dans ' + n + ' jours'; },
      season: function (n) { return 'Saison ' + n; }, sh: function (n) { return 'S' + n; }, newSeries: 'Nouvelle série',
      orig: 'VO : ', then: 'Ensuite : ', tagNew: 'Inédit',
      outIn: 'Diffusion', airs: 'Diffusion', day: 'jour', daysW: 'jours', today: 'Auj.',
      emptyMeta: 'Rien à afficher', offlineMeta: 'Programme indisponible', offline: 'Hors ligne',
      noFeed: 'Impossible de joindre Trakt pour le moment. Vérifiez le Client ID.',
      keyMeta: 'Réglage manquant', key: 'Client ID Trakt', keyTxt: 'Renseignez le Client ID de votre app Trakt (gratuite) dans les réglages du plugin.',
      empty: 'Aucune série', emptyTxt: 'Aucune première prévue dans les pays choisis d\'ici un mois.'
    },
    en: {
      seasons: 'New seasons', series: 'New series',
      countries: { US: 'American', GB: 'British', FR: 'French', CA: 'Canadian', BE: 'Belgian', ES: 'Spanish',
                   DE: 'German', IT: 'Italian', DK: 'Danish', SE: 'Swedish', NO: 'Norwegian', FI: 'Finnish',
                   IS: 'Icelandic', AU: 'Australian', KR: 'Korean', JP: 'Japanese', CN: 'Chinese', IN: 'Indian',
                   MX: 'Mexican', BR: 'Brazilian', AR: 'Argentine', CO: 'Colombian', NZ: 'New Zealand', IE: 'Irish',
                   NL: 'Dutch', PL: 'Polish', TR: 'Turkish', TW: 'Taiwanese', TH: 'Thai', CH: 'Swiss' },
      nation: function (c) { return c + ' series'; },
      updated: 'Last updated at ', upd: 'Upd. ',
      days: ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'],
      months: ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'],
      mshort: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
      date: function (d, m, n) { return d + ', ' + m + ' ' + n; },
      dshort: function (m, n) { return m + ' ' + n; },
      out: function (n) { return n === 0 ? 'Today' : n === 1 ? 'Tomorrow' : 'In ' + n + ' days'; },
      season: function (n) { return 'Season ' + n; }, sh: function (n) { return 'S' + n; }, newSeries: 'New series',
      orig: 'Original title: ', then: 'Next: ', tagNew: 'New',
      outIn: 'Airs in', airs: 'Airs', day: 'day', daysW: 'days', today: 'Today',
      emptyMeta: 'Nothing to show', offlineMeta: 'Schedule unavailable', offline: 'Offline',
      noFeed: 'Unable to reach Trakt right now. Check the Client ID.',
      keyMeta: 'Missing setting', key: 'Trakt Client ID', keyTxt: 'Enter the Client ID of your (free) Trakt app in the plugin settings.',
      empty: 'No series', emptyTxt: 'No premiere planned in the selected countries within a month.'
    }
  };

  // Les polices n'ont que l'alphabet latin : un titre en coréen, en japonais… s'afficherait mal
  var LATIN = /^[\u0000-ɏ -⁯℀-⅏]*$/;
  function latin(x) { return LATIN.test(x || ''); }
  function bare(x) { return String(x || '').toLowerCase().replace(/[^a-z0-9À-ɏ]/g, ''); }
  function json(el) { try { return JSON.parse(el.textContent); } catch (e) { return null; } }
  function esc(s) { return String(s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  // Titre : d'abord réduit sur une ligne, puis sur deux lignes s'il est encore trop long
  function fit(el) {
    el.style.fontSize = ''; el.classList.remove('wrap');
    var base = parseFloat(getComputedStyle(el).fontSize), size = base;
    var shrink = function () { size *= 0.94; el.style.fontSize = size + 'px'; };
    while (el.scrollWidth > el.clientWidth + 1 && size > base * 0.7) shrink();
    if (el.scrollWidth <= el.clientWidth + 1) return;
    el.classList.add('wrap');
    while ((el.scrollHeight > size * 2.1 + 2 || el.scrollWidth > el.clientWidth + 1) && size > base * 0.3) shrink();
  }

  function render(root) {
    root.setAttribute('data-done', '1');
    var q = function (s) { return root.querySelector(s); };
    var lang = root.dataset.lang === 'fr' ? 'fr' : 'en', t = I18N[lang];
    var ts = parseInt(root.dataset.ts, 10) || Math.floor(Date.now() / 1000), off = parseInt(root.dataset.off, 10) || 0;

    q('.sp-upd-long').textContent = t.updated;
    q('.sp-upd-short').textContent = t.upd;
    q('.sp-time').textContent = new Date((ts + off) * 1000).toISOString().substr(11, 5);

    // Jour de diffusion à l'heure locale (Trakt donne l'heure UTC de la première diffusion)
    var today = Math.floor((ts + off) / 86400);
    var dayOf = function (e) { return Math.floor((Date.parse(e.first_aired) / 1000 + off) / 86400); };
    var when = function (e, long) {
      var dt = new Date(dayOf(e) * 864e5);
      return long ? t.date(t.days[dt.getUTCDay()], t.months[dt.getUTCMonth()], dt.getUTCDate())
                  : t.dshort(t.mshort[dt.getUTCMonth()], dt.getUTCDate());
    };

    // Premières à venir, une par série, sans la téléréalité ni les titres illisibles
    var hype = {};
    (json(q('.sp-ant')) || []).forEach(function (a) { if (a.show) hype[a.show.ids.trakt] = a.list_count; });
    var seen = {}, lists = { seasons: [], series: [] };
    (json(q('.sp-prem')) || []).forEach(function (e) {
      var s = e && e.show, ep = e && e.episode;
      if (!s || !ep || !e.first_aired || seen[s.ids.trakt] || dayOf(e) < today || !latin(s.title)) return;
      if ((s.genres || []).some(function (g) { return SKIP.indexOf(g) >= 0; })) return;
      seen[s.ids.trakt] = true;
      var isNew = ep.episode_type === 'series_premiere' || ep.season === 1;
      e.rank = isNew ? hype[s.ids.trakt] || 0 : s.votes || 0;
      lists[isNew ? 'series' : 'seasons'].push(e);
    });
    ['seasons', 'series'].forEach(function (k) {
      lists[k].sort(function (a, b) { return b.rank - a.rank || dayOf(a) - dayOf(b); });
    });

    // Rubrique et série à l'affiche : chaque heure, une autre des cinq séries les plus suivies ou les plus attendues
    var secs = ['seasons', 'series'].filter(function (k) { return lists[k].length; });
    var sec = root.dataset.featured, slot = Math.floor(ts / 3600), idx;
    if (lists[sec] && lists[sec].length) idx = slot % Math.min(5, lists[sec].length);
    else {
      sec = secs[slot % (secs.length || 1)];
      if (sec) idx = Math.floor(slot / secs.length) % Math.min(5, lists[sec].length);
    }
    root.classList.add('sp--sec-' + (sec || 'seasons'));
    rays(root);
    q('.sp-k').textContent = t[sec || 'seasons'];

    if (!sec) {
      var nokey = !root.dataset.key, down = !!root.dataset.error;
      root.classList.add('sp--error', 'sp--noimg');
      q('.sp-k').textContent = 'ShowPoster';
      q('.sp-meta').textContent = nokey ? t.keyMeta : down ? t.offlineMeta : t.emptyMeta;
      q('.sp-title').textContent = nokey ? t.key : down ? t.offline : t.empty;
      q('.sp-genres').textContent = nokey ? t.keyTxt : down ? t.noFeed : t.emptyTxt;
      q('.sp-info').classList.add('sp-err');
      return fit(q('.sp-title'));
    }

    var list = lists[sec], e = list[idx], s = e.show, n = dayOf(e) - today;
    q('.sp-title').textContent = s.title;
    q('.sp-meta').textContent = (sec === 'series' ? t.newSeries : t.season(e.episode.season)) + ' · ' + when(e, true);
    q('.sp-tag').textContent = sec === 'series' ? t.tagNew : t.season(e.episode.season);

    // Chaîne ou plateforme, pays d'origine et genres ; le titre original s'ajoute si TMDB en donne un autre
    var c = t.countries[String(s.country || '').toUpperCase()];
    var genres = (s.genres || []).map(function (g) { return GENRES[lang][g]; }).filter(Boolean).slice(0, 2);
    var parts = (s.network ? ['<b>' + esc(s.network) + '</b>'] : []).concat(c ? [t.nation(c)] : [], genres);
    var sub = function (orig) { q('.sp-genres').innerHTML = parts.concat(orig ? [t.orig + esc(orig)] : []).join(' · '); };
    sub('');

    // Ensuite : les autres premières de la rubrique dans l'ordre du calendrier
    var others = list.filter(function (o) { return o !== e; }).sort(function (a, b) { return dayOf(a) - dayOf(b); });
    q('.sp-next').innerHTML = others.length ? t.then + others.slice(0, 4).map(function (o) {
      return esc(o.show.title) + (sec === 'seasons' ? ' ' + t.sh(o.episode.season) : '') + ' <b>' + when(o, false) + '</b>';
    }).join(' · ') : '';

    // Tampon : le compte à rebours avant la diffusion
    var ring = q('.sp-ring');
    q('.sp-stamp-k').textContent = n === 0 ? t.airs : t.outIn;
    ring.textContent = n === 0 ? t.today : n;
    if (n === 0) ring.classList.add('word'); else if (n > 99) ring.classList.add('long');
    q('.sp-stamp-l').textContent = n === 0 ? '' : n === 1 ? t.day : t.daysW;
    fit(q('.sp-title'));

    // Affiche et titre traduit chez TMDB (Trakt interdit de charger ses images en direct)
    var key = root.dataset.tmdb;
    if (!key || !s.ids.tmdb) return root.classList.add('sp--noimg');
    fetch('https://api.themoviedb.org/3/tv/' + s.ids.tmdb + '?api_key=' + encodeURIComponent(key) + '&language=' + (lang === 'fr' ? 'fr-FR' : 'en-US'))
      .then(function (r) { return r.ok ? r.json() : null; })
      .then(function (d) {
        if (!d) return root.classList.add('sp--noimg');
        if (d.name && latin(d.name) && bare(d.name) !== bare(s.title)) {
          q('.sp-title').textContent = d.name; fit(q('.sp-title'));
          sub(s.title);
        }
        cover(root, d.poster_path || d.backdrop_path);
      })
      .catch(function () { root.classList.add('sp--noimg'); });
  }

  // Affiche cadrée à son format d'origine dans la zone du ciel
  function cover(root, path) {
    var img = root.querySelector('.sp-cover'), frame = root.querySelector('.sp-frame'), art = root.querySelector('.sp-art');
    if (!path) return root.classList.add('sp--noimg');
    var place = function () {
      var w = img.naturalWidth, h = img.naturalHeight;
      if (!w || !h) return root.classList.add('sp--noimg');
      var k = Math.min(art.clientWidth / w, art.clientHeight / h);
      frame.style.width = Math.round(w * k) + 'px'; frame.style.height = Math.round(h * k) + 'px';
      root.classList.add('sp--img');
    };
    img.onload = place;
    img.onerror = function () { root.classList.add('sp--noimg'); };
    img.src = IMG + path;
    if (img.complete && img.naturalWidth) place();
  }

  // Faisceaux de projecteurs derrière l'affiche, façon générique
  function rays(root) {
    var NS = 'http://www.w3.org/2000/svg', g = root.querySelector('.sp-rays-g'), cx = 640, cy = 300, n = 18, r = 1600;
    for (var i = 0; i < n; i++) {
      var a0 = (i * 2) * Math.PI / n, a1 = (i * 2 + 1) * Math.PI / n;
      var p = document.createElementNS(NS, 'path');
      p.setAttribute('d', 'M' + cx + ' ' + cy + ' L' + (cx + r * Math.cos(a0)) + ' ' + (cy + r * Math.sin(a0))
        + ' L' + (cx + r * Math.cos(a1)) + ' ' + (cy + r * Math.sin(a1)) + ' Z');
      g.appendChild(p);
    }
  }

  function boot() { document.querySelectorAll('.sp:not([data-done])').forEach(render); }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot); else boot();
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(function () {
    document.querySelectorAll('.sp-title').forEach(fit);
  });
})();
</script>
